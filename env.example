# frigate-motion-exporter configuration.
#
# Copy this file to .env in this directory and set what you need:
#
#     cp env.example .env
#
# docker compose (compose.yaml, compose.debug.yaml) loads .env as a required
# env_file: without the file compose refuses to start, since S3_BUCKET has no
# default. Without Docker the archiver reads the same variables from the
# process environment: `set -a; . ./.env; set +a` before running
# `python3 frigate_s3_archiver.py`.
#
# Every variable is optional except S3_BUCKET. Uncommented values below are
# the program defaults.

### Frigate #################################################################

# Base URL of the Frigate server. From inside a container the host's Frigate
# is reachable as host.docker.internal, not localhost.
FRIGATE_URL=http://localhost:5000

# HTTP Basic Auth is attached only when FRIGATE_USER is set; leave both
# unset for an open localhost Frigate.
#FRIGATE_USER=archiver
#FRIGATE_PASSWORD=secret

# Camera filter: regexes (re.search on the camera name), exactly one of
# the two may be set.
#CAMERAS_INCLUDE=^front
#CAMERAS_EXCLUDE=^back

### S3 (standard boto3 credential chain) ####################################

# REQUIRED. Target bucket; the archiver exits at startup without it.
S3_BUCKET=my-motion-archive

# Credentials/region/endpoint use the default AWS/boto3 chain. Either pass
# them through directly:
#AWS_ACCESS_KEY_ID=AKIAXXXX
#AWS_SECRET_ACCESS_KEY=yyyy
#AWS_REGION=us-east-1
# ...or select a profile from a mounted ~/.aws:
#AWS_PROFILE=default
# Non-AWS endpoint (MinIO, Yandex Object Storage, Cloudflare R2, ...):
#AWS_ENDPOINT_URL_S3=https://s3.example.internal

# Key layout: <S3_PREFIX><camera>/<YYYY>/<MM>/<DD>/<HH>/<start>-<camera>.mp4
#S3_PREFIX=frigate
# IANA zone for the date/hour folders. Must never change once the bucket
# holds objects.
#S3_KEY_TIMEZONE=Europe/Moscow
# Multipart part size in bytes; at least the 5 MiB S3 minimum.
#S3_PART_SIZE=5242880

### Archiving schedule ########################################################

# A camera's first pass starts this far back (3 days).
#FIRST_RUN_LOOKBACK_SECONDS=259200
# Cap on how far back a resumed camera re-reads its watermark (24 h).
#WATERMARK_LOOKBACK_SECONDS=86400
# Recordings separated by a longer pause start a new clip (40 s).
#MAX_GAP_SECONDS=40
# Sleep between scans once caught up (60 s).
#IDLE_SLEEP_SECONDS=60

### Retries and timeouts ######################################################

# Re-fetch attempts for a failed clip window; the truncated, no-recordings
# and empty-200 chains share this budget. The pause doubles from 10 s up to
# the max, so the defaults span ~310 s - long enough to outlast a Frigate
# restart.
#CLIP_RETRIES=6
#CLIP_RETRY_MAX_DELAY_SECONDS=80
# Timeout for one Frigate clip/download request (5 min).
#HTTP_TIMEOUT=300
# Per-camera supervisor restart backoff, first pause and ceiling.
#CAMERA_RESTART_BACKOFF_SECONDS=5
#CAMERA_RESTART_BACKOFF_MAX_SECONDS=300

### Metrics ###################################################################

# Port and bind address of the Prometheus listener (/metrics).
#METRICS_PORT=9108
#METRICS_BIND=0.0.0.0
