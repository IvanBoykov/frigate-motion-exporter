# frigate-motion-exporter configuration.
#
# Copy this file to .env in this directory and set what you need:
#
#     cp env.example .env
#
# docker compose (compose.yaml, compose.debug.yaml) loads .env as a required
# env_file: without the file compose refuses to start, since S3_BUCKET has no
# default. Without Docker the archiver reads the same variables from the
# process environment: `set -a; . ./.env; set +a` before running
# `python3 src/frigate_s3_archiver.py`.
#
# Every variable is optional except S3_BUCKET. Uncommented values below are
# the program defaults.

### Frigate #################################################################

# Base URL of the Frigate server. From inside a container the host's Frigate
# is reachable as host.docker.internal, not localhost.
FRIGATE_URL=http://localhost:5000

# HTTP Basic Auth is attached only when FRIGATE_USER is set; leave both
# unset for an open localhost Frigate.
#FRIGATE_USER=archiver
#FRIGATE_PASSWORD=secret

# Camera filter: regexes (re.search on the camera name), exactly one of
# the two may be set.
#CAMERAS_INCLUDE=^front
#CAMERAS_EXCLUDE=^back

### S3 (standard boto3 credential chain) ####################################

# REQUIRED. Target bucket; the archiver exits at startup without it.
S3_BUCKET=my-motion-archive

# Credentials/region/endpoint use the default AWS/boto3 chain. Either pass
# them through directly:
#AWS_ACCESS_KEY_ID=AKIAXXXX
#AWS_SECRET_ACCESS_KEY=yyyy
#AWS_REGION=us-east-1
# ...or select a profile from a mounted ~/.aws:
#AWS_PROFILE=default
# Non-AWS endpoint (MinIO, Yandex Object Storage, Cloudflare R2, ...):
#AWS_ENDPOINT_URL_S3=https://s3.example.internal

# Key layout: <S3_PREFIX><camera>/YYYY/MM/DD/HH/MM-SS.mp4, where MM-SS is the
# clip start rendered in S3_KEY_TIMEZONE.
#S3_PREFIX=frigate
# IANA zone for the date/hour folders. Must never change once the bucket
# holds objects. A zone with DST folds two real hours into one key name on
# the fall-back hour - one clip then overwrites the other; the process warns
# at startup about it. UTC (or Europe/Moscow, DST-free since 2014) is safest.
#S3_KEY_TIMEZONE=Europe/Moscow
# Multipart part size in bytes; at least the 5 MiB S3 minimum.
#S3_PART_SIZE=5242880

### Archiving schedule ########################################################

# A camera's first pass starts this far back (3 days).
#FIRST_RUN_LOOKBACK_SECONDS=259200
# Cap on how far back a resumed camera re-reads its watermark (24 h).
#WATERMARK_LOOKBACK_SECONDS=86400
# Recordings separated by a longer pause start a new clip (40 s).
#MAX_GAP_SECONDS=40
# Sleep between scans once caught up (60 s).
#IDLE_SLEEP_SECONDS=60

### Retries and timeouts ######################################################

# Re-fetch attempts for a failed clip window; the truncated, no-recordings
# and empty-200 chains share this budget. The pause doubles from 10 s up to
# the max, so the defaults span ~310 s - long enough to outlast a Frigate
# restart.
#CLIP_RETRIES=6
#CLIP_RETRY_MAX_DELAY_SECONDS=80
# Timeout for one Frigate clip/download request (5 min).
#HTTP_TIMEOUT=300
# Per-camera supervisor restart backoff, first pause and ceiling.
#CAMERA_RESTART_BACKOFF_SECONDS=5
#CAMERA_RESTART_BACKOFF_MAX_SECONDS=300

### Retention (deleting old footage) #########################################

# Both thresholds are UNSET by default, so an upgrade deletes nothing. Setting
# either one enables retention; deletion itself still defaults to a dry run,
# which plans and reports but never removes an object. Read the first pass's
# log line (and the retention_* metrics) before enabling RETENTION_DRY_RUN=false.
#
# The two thresholds are not alternatives at the same level: KEEP_DAYS is a
# hard floor and KEEP_BYTES is a target above it. The newest 24*KEEP_DAYS hour
# folders of every camera are never deleted, whatever the archive costs, so a
# size target can never empty the bucket - it can only refuse to fit.
# KEEP_DAYS=0 is a legal "no day floor": size alone then decides, down to the
# newest hour folder of every camera.
#
# KEEP_DAYS counts folders that exist, not calendar days since now: an archive
# with no motion for a week keeps what it has rather than losing it on a
# date-based rule.

# Protected depth per camera, in hour folders / 24. Required whenever
# RETENTION_KEEP_BYTES is set, and whenever RETENTION_DRY_RUN=false (deletion
# enabled with no threshold at all is refused at startup). 0 = no day floor.
#RETENTION_KEEP_DAYS=30
# Total archive size to stay under, in BYTES. Deletion is a global
# oldest-hour-first sweep across all cameras, so horizons move together instead
# of one camera being drained first.
#RETENTION_KEEP_BYTES=161061273600
# How much new footage to leave room for between passes. Estimated from the
# archive's own growth when unset (sum of every camera's newest hours covering
# one prune interval); set it when you know the daily rate. 0 disables the
# reservation: the pass then aims at RETENTION_KEEP_BYTES itself and a soft
# quota may be briefly over. Reserve nothing only if overshooting until the
# next pass is acceptable - with a hard quota, keep a positive value.
# Fraction of one pass's deletion relative to the archive size, per pass. The
# brake that stops one misconfigured threshold from emptying the bucket in a
# single pass. 100 disables it.
#RETENTION_MAX_DELETE_PERCENT=25
# Seconds between prune passes (45 min). Lowering it does not make deletion
# faster per pass, only more often.
#RETENTION_PRUNE_INTERVAL_SECONDS=2700
# Refuse to delete at all when more than this fraction of the bytes under the
# prefix is keys this archiver did not write - a changed S3_PREFIX makes a whole
# healthy archive look foreign. (S3_KEY_TIMEZONE does not: renamed folders still
# parse as ours, so the foreign-key guard cannot catch a zone change. It breaks
# the watermark instead - see README.)
#RETENTION_MAX_UNKNOWN_FRACTION=0.5
# Plan without deleting (true). false is the only setting that removes objects.
#RETENTION_DRY_RUN=true
# Cap a cold start's depth at KEEP_DAYS so a restart does not re-archive
# footage the next pass deletes. Affects a camera with nothing in the bucket
# only; an existing watermark is never clamped.
#RETENTION_LIMIT_UPLOAD_DEPTH=true

### Metrics ###################################################################

# Port and bind address of the Prometheus listener (/metrics).
#METRICS_PORT=9108
#METRICS_BIND=0.0.0.0

### Logging ###################################################################

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive; WARN
# is accepted). INFO is the run-as-a-service setting: startup, per-pass
# summaries, and every anomaly. DEBUG adds what a retry or a stall is waiting
# on: every SDK-internal S3 retry, each clip-window retry pause, the scan
# windows queried, the watermark prefixes listed, deferred tails, and the
# per-clip S3 keys. The boto3/urllib3 debug firehose is silenced.
# An unreadable value fails startup naming this variable.
#LOG_LEVEL=INFO
# Emit one JSON object per line instead of text (for a JSON log pipeline).
#LOG_JSON=false

# One-shot backfill over an explicit window (manual catch-up after downtime
# deeper than FIRST_RUN_LOOKBACK_SECONDS). Set BOTH to run one pass per camera
# over [AFTER, BEFORE) and exit; unset both to run the normal loop. Epoch
# seconds or ISO 8601 (Z or an offset; naive reads as UTC). Resumable: present
# clips skip, so re-running the same window fills only what is missing.
# RETENTION_DRY_RUN=false with a backfill window is refused at startup -
# backfill first, then run the normal process.
#BACKFILL_AFTER=2026-10-01T00:00:00+03:00
#BACKFILL_BEFORE=2026-10-04T00:00:00+03:00
